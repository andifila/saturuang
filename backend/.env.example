# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
# Untuk Gmail: buat App Password di myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM="SatuRuang Photobox" <your-email@gmail.com>

# ── Printer ───────────────────────────────────────────────────────────────────
# Nama printer persis seperti yang terinstall di Windows (Devices & Printers)
PRINTER_NAME=DNP DS-RX1HS

# ── Midtrans (Pembayaran QRIS) ────────────────────────────────────────────────
# Ambil di: https://dashboard.sandbox.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# ── Dashboard Owner ───────────────────────────────────────────────────────────
# Wajib diset, minimal 6 karakter. Server tidak akan start tanpa ini.
DASHBOARD_PIN=ganti-dengan-pin-anda
