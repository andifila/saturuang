# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
# Untuk Gmail: buat App Password di myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM="SatuRuang Photobox" <your-email@gmail.com>

# ── Printer ───────────────────────────────────────────────────────────────────
# Nama printer persis seperti yang terinstall di Windows (Devices & Printers)
PRINTER_NAME=DNP DS-RX1HS

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
